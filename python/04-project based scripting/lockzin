#!/usr/bin/python3
import os
import subprocess
import sys
import pexpect
from getpass import getpass

# 1. Path configuration
home = os.environ.get("HOME", "")
pass_script = os.path.join(home, "bin", "pass")
keyfile = os.path.join(home, "keyde")
cipherdir = os.path.join(home, "storage", "shared", "Zin")

# 2. Generate new password silently
try:
    with open(keyfile, "w") as out:
        subprocess.run(
            [pass_script, "16"], stdout=out, stderr=subprocess.DEVNULL, check=True
        )
except (subprocess.CalledProcessError, OSError) as e:
    sys.exit(f"Error generating password: {e}")

# 3. Read new password
try:
    with open(keyfile, "r") as fp:
        new_password = fp.read().strip()
except OSError as e:
    sys.exit(f"Error reading keyfile: {e}")

# 4. Prompt for old password securely
old_password = getpass("Enter old password: ")

# 5. Automate gocryptfs password change
try:
    child = pexpect.spawn(
        f"gocryptfs -passwd {cipherdir}", encoding="utf-8", timeout=30
    )

    # Old Password
    child.expect("Password:")
    child.sendline(old_password)

    # New Password
    child.expect("Please enter your new password.")
    child.expect("Password:")
    child.sendline(new_password)

    # Confirm New Password
    child.expect("Repeat:")
    child.sendline(new_password)

    # Wait for process completion
    child.expect(pexpect.EOF)
    child.close()

    if child.exitstatus == 0:
        print("\nPassword changed successfully.")
    else:
        sys.exit(f"\ngocryptfs failed with exit code {child.exitstatus}")

except pexpect.TIMEOUT:
    sys.exit("\nError: Process timed out waiting for prompt.")
except pexpect.EOF:
    sys.exit("\nError: Process ended unexpectedly.")
